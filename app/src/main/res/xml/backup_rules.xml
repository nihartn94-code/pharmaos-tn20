<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude Android Keystore-encrypted JWT token store, session preferences, and local Room database -->
    <exclude domain="sharedpref" path="pharmaos_secure_tokens.xml" />
    <exclude domain="file" path="datastore/pharmaos_session.preferences_pb" />
    <exclude domain="database" path="pharmaos_database.db" />
    <exclude domain="database" path="pharmaos_database.db-wal" />
    <exclude domain="database" path="pharmaos_database.db-shm" />
</full-backup-content>
